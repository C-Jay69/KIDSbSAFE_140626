{
  "expo": {
    "name": "KIDSbSAFE",
    "slug": "kidsbsafe",
    "version": "1.0.0",
    "scheme": "kidsbsafe",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.kidsbsafe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0B14"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kidsbsafe.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KIDSbSAFE shares your device's location with your parent so they can keep you safe. Location is only used for the GPS safety map and is visible to you."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#0A0B14"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://kidsbsa-njincq3-preview-4200.runable.site/",
      "applicationId": "kidsbsa-njincq3"
    }
  }
}
