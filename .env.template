# Environment
NODE_ENV=development
# Public origin of this deployment. Used for Better Auth callbacks and CORS.
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
# Generate a unique value per environment: openssl rand -hex 32
# NEVER ship a real secret in this template or commit a filled-in .env.
BETTER_AUTH_SECRET=

# Database (PostgreSQL)
DATABASE_URL=
# Set to false when using a Supabase transaction pooler (pgbouncer, port 6543).
DATABASE_PREPARE=true
# Max pooled connections per instance.
DATABASE_POOL_MAX=10

# Comma-separated extra browser origins allowed to call the API (optional).
CORS_ORIGINS=
# Comma-separated extra origins trusted by Better Auth (optional; native app
# schemes are trusted automatically).
TRUSTED_ORIGINS=

# Google Safe Browsing (optional)
GOOGLE_SAFE_BROWSING_KEY=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Image search (landing-page photography, build-time only)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Contact form relay (SMTP). Leave unset to serve the mailto fallback instead.
# For most providers use port 587 (STARTTLS) or 465 (implicit TLS).
SMTP_HOST=
SMTP_PORT=587
# true/false; defaults to true when SMTP_PORT is 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Where messages are delivered (default support@hydraforge.tech).
CONTACT_TO=
# Envelope sender; must be an address the SMTP account may send as.
CONTACT_FROM=
